# ================================
# Connectly Backend — Environment Variables
# ================================
# Copy this file to .env and fill in your production values

# Server
PORT=5000
NODE_ENV=production

# MySQL Database (use your cloud MySQL provider credentials)
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_NAME=connectly
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=true

# JWT Authentication (generate strong random secrets for production!)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_A_STRONG_64_CHAR_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GENERATE_ANOTHER_STRONG_64_CHAR_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# CORS — Your Cloudflare Workers frontend URL (no trailing slash)
FRONTEND_URL=https://connectly.mohitsonawane425.workers.dev
CLIENT_URL=https://connectly.mohitsonawane425.workers.dev

# Optional: Additional allowed origins (comma-separated)
# ALLOWED_ORIGINS=https://connectly.mohitsonawane425.workers.dev,http://localhost:5173
